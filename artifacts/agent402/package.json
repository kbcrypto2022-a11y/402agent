{
  "name": "@workspace/agent402",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval": "tsx src/evals/run.ts",
    "smoke": "X402_MODE=testnet tsx scripts/smoke.ts",
    "monitor:cdp-discovery": "tsx scripts/cdp-discovery-monitor.ts"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.55.0",
    "@workspace/db": "workspace:*",
    "@x402/core": "^2.22.0",
    "@x402/evm": "^2.22.0",
    "@x402/express": "^2.22.0",
    "@x402/extensions": "^2.22.0",
    "@x402/fetch": "^2.22.0",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "undici": "^8.10.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.2",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "viem": "^2.55.17",
    "vite": "catalog:",
    "vitest": "^3.0.0"
  }
}
